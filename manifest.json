{
  "manifest_version": 3,
  "name": "Studocu Premium Helper",
  "version": "0.1",
  "description": "Extension tự động tạo tài liệu hỗ trợ kích hoạt nhanh Studocu Premium",
  "author": "iamnhtt (https://github.com/nguyenhoangtuantu)",
  "homepage_url": "https://github.com/nguyenhoangtuantu/studocu-Prenium",
  "permissions": ["storage"],
  "action": {
    "default_title": "Studocu Premium Helper",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.studocu.vn/vn/document/upload*",
        "https://www.studocu.com/*/document/upload*"
      ],
      "js": ["shared/docx-generator.js", "content/form-filler.js", "content/uploader.js"]
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
